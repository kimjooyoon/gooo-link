package coreimprovementselection
namespace coreimprovementselection

entity ConsumerReleaseIdentities id "gooo://selection/entity/consumer-release-identities"
entity MergedAdoptionReceipts id "gooo://selection/entity/merged-adoption-receipts"
entity DistinctProjectGraphs id "gooo://selection/entity/distinct-project-graphs"
entity CompleteGeneration id "gooo://selection/entity/complete-generation"
entity PromotedPatterns id "gooo://selection/entity/promoted-patterns"
entity GeneratedFileCounts id "gooo://selection/entity/generated-file-counts"
entity MissingResolution id "gooo://selection/entity/missing-resolution"
entity DuplicateResolution id "gooo://selection/entity/duplicate-resolution"
entity DomainSpecificCounts id "gooo://selection/entity/domain-specific-counts"
entity ZeroRepositoryWrites id "gooo://selection/entity/zero-repository-writes"
entity ReleasedCoreEvidence id "gooo://selection/entity/released-core-evidence"
entity CoreActivityResolutionReceipts id "gooo://selection/entity/core-activity-resolution-receipts"
entity CoreAdoptionDecision id "gooo://selection/entity/core-adoption-decision"

activity ObserveConsumerReleaseIdentities(ConsumerReleaseIdentities) -> CoreAdoptionDecision
activity ObserveMergedAdoptionReceipts(MergedAdoptionReceipts) -> CoreAdoptionDecision
activity ObserveDistinctProjectGraphs(DistinctProjectGraphs) -> CoreAdoptionDecision
activity ObserveCompleteGeneration(CompleteGeneration) -> CoreAdoptionDecision
activity ComparePromotedPatterns(PromotedPatterns) -> CoreAdoptionDecision
activity CompareGeneratedFileCounts(GeneratedFileCounts) -> CoreAdoptionDecision
activity CompareMissingResolution(MissingResolution) -> CoreAdoptionDecision
activity CompareDuplicateResolution(DuplicateResolution) -> CoreAdoptionDecision
activity PreserveDomainSpecificCounts(DomainSpecificCounts) -> CoreAdoptionDecision
activity ObserveZeroRepositoryWrites(ZeroRepositoryWrites) -> CoreAdoptionDecision
activity ObserveDeterministicArtifacts(ReleasedCoreEvidence) -> CoreAdoptionDecision
activity SelectActivityCardinalityPrimitive(CoreActivityResolutionReceipts) -> CoreAdoptionDecision
