entity CoreMetaToolCell id "gooo://forge-readiness/cell/core-tool"
entity LocalProductCell id "gooo://forge-readiness/cell/local-product"
entity InfraProductCell id "gooo://forge-readiness/cell/infra-product"
entity SharedPrimitiveCell id "gooo://forge-readiness/cell/shared-primitive"
