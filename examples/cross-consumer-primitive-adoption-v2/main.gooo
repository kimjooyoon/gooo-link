entity ClaimResolutionCandidateIdentity id "gooo://claim-resolution/gooo.primitive.claim-resolution-tuple.v1"
entity BaselineDirectMappingCount id "gooo://claim-resolution/direct-mappings/2-of-30"
entity LocalIndependentAdoption id "gooo://claim-resolution/local-independent-adoption/1-of-1"
entity LocalClaimEvidence id "gooo://claim-resolution/local-scenarios/3-of-3"
entity LocalInventoryContext id "gooo://claim-resolution/local-inventory/4-of-4"
entity UnknownClassBoundary id "gooo://claim-resolution/local-unknown-class/1-of-1"
entity LocalAdverseUnknown id "gooo://claim-resolution/local-adverse-unknown/1-of-1"
entity LocalAdverseRefutations id "gooo://claim-resolution/local-adverse-refutations/4-of-4"
entity ObservationAuthorityBoundary id "gooo://claim-resolution/observation-authority/v2"
entity ThirdDirectMapping id "gooo://claim-resolution/direct-mappings/3-of-30"
entity CrossConsumerPrimitiveAdoptionReport id "gooo://link/cross-consumer-primitive-adoption/v2"

activity ObserveBaselinePrimitiveAdoption(BaselinePrimitiveAdoption) -> CrossConsumerPrimitiveAdoptionReport
