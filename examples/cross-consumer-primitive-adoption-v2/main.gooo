activity ObserveLocalInventoryContext(LocalInventoryContext) -> CrossConsumerPrimitiveAdoptionReport
activity PreserveUnknownClassBoundary(UnknownClassBoundary) -> CrossConsumerPrimitiveAdoptionReport
activity PreserveLocalAdverseUnknown(LocalAdverseUnknown) -> CrossConsumerPrimitiveAdoptionReport
activity PreserveLocalAdverseRefutations(LocalAdverseRefutations) -> CrossConsumerPrimitiveAdoptionReport
activity PreserveObservationAuthorityBoundary(ObservationAuthorityBoundary) -> CrossConsumerPrimitiveAdoptionReport
activity RecordThirdDirectMapping(ThirdDirectMapping) -> CrossConsumerPrimitiveAdoptionReport
