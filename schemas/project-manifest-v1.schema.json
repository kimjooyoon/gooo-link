{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://gooo.dev/schemas/link/project-manifest-v1.schema.json","title":"Gooo Link project manifest v1","type":"object",
  "required":["schema","project","source","core","contracts","evidence_refs","links"],
